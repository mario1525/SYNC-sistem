# Copie este archivo a Docker/.env y reemplace TODOS los valores.
# .env está en .gitignore: nunca lo suba al repositorio.

# Contraseña del usuario SA de SQL Server (mín. 8 caracteres, mayúscula, minúscula, número y símbolo)
SQL_SA_PASSWORD=Cambie-Esta-Clave#2026
SQL_PORT=1433

# Clave de firma JWT (mínimo 32 caracteres aleatorios). Genérela con:
#   openssl rand -base64 48
JWT_SECRET=reemplace-por-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_ISSUER=sync-user-service
JWT_AUDIENCE=sync-app

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:4200

# Usuario Root inicial: se crea SOLO si la base no tiene credenciales.
# Después del primer arranque puede borrar estas dos variables.
SEED_ROOT_USER=root
SEED_ROOT_PASSWORD=Cambie-Esta-Clave#2026
SEED_ROOT_COMP=SYNC

ASPNETCORE_ENVIRONMENT=Production

# Zona horaria de la base de datos y puerto del frontend
TZ=America/Bogota
FRONTEND_PORT=4200
